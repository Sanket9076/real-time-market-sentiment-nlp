# Database Configuration (PostgreSQL)
# If DB_TYPE is set to postgres, the system connects to PostgreSQL.
# If DB_TYPE is set to sqlite (or DB credentials are unset), SQLite fallback is automatically used.
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_sentiment_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Key Configuration
# Obtain your free NewsAPI key at https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Obtain free Finnhub API key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Application Settings
DATA_MODE=demo  # Options: 'demo' (offline sample data) or 'live' (real-time API ingestion)
DEFAULT_ASSET=AAPL
LOG_LEVEL=INFO
